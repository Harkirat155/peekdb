# PostgreSQL — single-database shorthand (alternative to --config)
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# PostgreSQL — per-database passwords when using databases.toml
# STAGING_DB_PASSWORD=changeme
# PROD_DB_PASSWORD=changeme

# MongoDB — per-database passwords when using databases.toml
# MONGO_PASSWORD=changeme
# MONGO_PROD_PASSWORD=changeme

# Optional
# MCP_MAX_ROWS=500
# RUST_LOG=info
