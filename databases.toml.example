# mcp-db-readonly database config
# Copy to databases.toml and fill in your connection details.
# databases.toml is gitignored — never commit real credentials.
#
# Passwords: use ${ENV_VAR} to pull values from the environment.

# ── PostgreSQL databases ───────────────────────────────────────────────────────

[[database]]
name   = "local"
url    = "postgres://postgres@localhost:5432/mydb"
no_tls = true

[[database]]
name   = "staging"
url    = "postgres://app_user:${STAGING_DB_PASSWORD}@staging-db.example.com:5432/app"
no_tls = false

[[database]]
name   = "prod"
url    = "postgres://readonly_user:${PROD_DB_PASSWORD}@prod-db.example.com:5432/app"
no_tls = false

# ── MongoDB databases ──────────────────────────────────────────────────────────
# The URI must include the database name in the path (e.g. /mydb).
# Replica set URIs (host1:port,host2:port) are supported.

[[mongo]]
name = "mydb-local"
uri  = "mongodb://user:${MONGO_PASSWORD}@localhost:27017/mydb"

[[mongo]]
name = "mydb-prod"
uri  = "mongodb://user:${MONGO_PROD_PASSWORD}@mongo1.example.com:27017,mongo2.example.com:27017/mydb?authSource=admin"

# ── Redis instances ─────────────────────────────────────────────────────────────
# Use rediss:// (not redis://) for TLS.

[[redis]]
name = "cache-local"
url  = "redis://localhost:6379"

[[redis]]
name = "cache-prod"
url  = "rediss://:${REDIS_PROD_PASSWORD}@redis-prod.example.com:6380"
